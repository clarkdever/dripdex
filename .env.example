# DripDex safe local defaults. Copy to .env.local and fill real secrets there.

# Single-owner auth
DRIPDEX_OWNER_USERNAME=owner
DRIPDEX_OWNER_PASSWORD_HASH=
DRIPDEX_AUTH_SECRET=
DRIPDEX_TRUST_FORWARDED_IP=

# AI provider selection. Keep mock as the default for local development and CI.
DRIPDEX_AI_PROVIDER=mock

# OpenAI direct SDK
OPENAI_API_KEY=
OPENAI_IDENTIFICATION_MODEL=gpt-5.5

# Anthropic direct SDK
ANTHROPIC_API_KEY=
ANTHROPIC_IDENTIFICATION_MODEL=claude-sonnet-4-5-20250929

# Optional live smoke tests. Leave disabled unless you intentionally want to spend provider credits.
DRIPDEX_LIVE_AI_TESTS=0
