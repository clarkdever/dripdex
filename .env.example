# DripDex safe local defaults. Copy to .env.local and fill real secrets there.
# Never commit .env.local or paste secret values into chat, issues, screenshots, or docs.

# Vercel account and environment variable docs:
# https://vercel.com/signup
# https://vercel.com/docs/environment-variables
# https://vercel.com/docs/cli/env

# Single-owner auth.
# Generate DRIPDEX_OWNER_PASSWORD_HASH with: npm run owner:hash
# Generate DRIPDEX_AUTH_SECRET with: openssl rand -base64 48
DRIPDEX_OWNER_USERNAME=owner
DRIPDEX_OWNER_PASSWORD_HASH=
DRIPDEX_AUTH_SECRET=
DRIPDEX_TRUST_FORWARDED_IP=

# AI provider selection. Keep mock as the default for local development and CI.
DRIPDEX_AI_PROVIDER=mock

# OpenAI direct SDK.
# API keys dashboard: https://platform.openai.com/api-keys
# API key help: https://help.openai.com/en/articles/4936850-where-do-i-find-my-openai-api-key
OPENAI_API_KEY=
OPENAI_IDENTIFICATION_MODEL=gpt-5.5

# Anthropic direct SDK.
# API keys dashboard: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_IDENTIFICATION_MODEL=claude-sonnet-4-5-20250929

# Optional live smoke tests. Leave disabled unless you intentionally want to spend provider credits.
DRIPDEX_LIVE_AI_TESTS=0
